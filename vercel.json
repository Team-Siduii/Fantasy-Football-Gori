{
  "functions": {
    "src/app/api/wk/sync-points/route.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/wk/sync-points",
      "schedule": "*/15 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ]
}
